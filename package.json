{
  "name": "hosting",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Deploy GitHub repos to this server with ports, domains, and Caddy.",
  "bin": {
    "hosting": "./dist/cli.js"
  },
  "scripts": {
    "dev": "node --watch --import tsx src/server.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "tsc && vite build --config web/vite.config.ts && chmod +x dist/cli.js",
    "start": "node dist/server.js",
    "cli": "node dist/cli.js"
  },
  "dependencies": {
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.17.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  }
}
